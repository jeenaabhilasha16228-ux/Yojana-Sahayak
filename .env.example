# Google Gemini API Key for server-side AI processing (Required on Vercel & local)
GEMINI_API_KEY=your_api_key_here

# Gemini Model alias/name (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Supabase Auth & Storage (Optional: Add in Vercel Settings -> Environment Variables for Supabase cloud auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional App URL for production deployment
APP_URL=https://your-domain.vercel.app
